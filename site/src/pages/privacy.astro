  .doc h2{font-family:"Manrope",sans-serif;font-size:1.3rem;margin:34px 0 8px}
  .doc a{color:#B8420A}
  .doc .muted{color:#9aa0aa;font-size:.9rem}
  .doc .back{color:#6B7280;font-size:.95rem}
  .doc ul{padding-left:1.2em}
  body{background:#fff}
</style>
</Base>
